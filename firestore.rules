rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    match /games/{gameId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /gamePricing/{gameId} {
      allow read, write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if signedIn();

      allow create: if signedIn() && (
        isAdmin()
        || (
          request.resource.data.paymentStatus == 'pendiente'
          && request.resource.data.workStatus == 'pendiente'
          && request.resource.data.quantity is number
          && request.resource.data.quantity > 0
          && request.resource.data.clientName is string
          && request.resource.data.gameId is string
          && request.resource.data.gameNameSnapshot is string
        )
      );

      allow update: if signedIn() && (
        isAdmin()
        || (
          request.resource.data.paymentStatus == resource.data.paymentStatus
          && request.resource.data.createdAt == resource.data.createdAt
        )
      );

      allow delete: if signedIn();

      match /billing/{docId} {
        allow read, write: if isAdmin();
      }
    }
  }
}
